# Application Configuration
NODE_ENV=development
PORT=5000

# Security & CORS
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# API Versioning
API_PREFIX=/api/v1

# MongoDB Atlas (Will be configured in Step 2 per architectural rules)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/enterprise_crm?retryWrites=true&w=majority
