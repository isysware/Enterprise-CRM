# Application Configuration
NODE_ENV=development
PORT=5000

# Security & CORS
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication & Session (JWT + HttpOnly Cookies)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_minimum_32_characters_long

# API Versioning
API_PREFIX=/api/v1

# PostgreSQL Database
# DATABASE_URL=postgresql://postgres:password@localhost:5432/enterprise_crm?schema=public

# Initial Super Admin Bootstrap (Optional; only provisioned if database has 0 Super Admins and both values are provided)
# BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@example.com
# BOOTSTRAP_SUPERADMIN_PASSWORD=your_secure_bootstrap_password
# BOOTSTRAP_SUPERADMIN_NAME=Initial Super Admin
