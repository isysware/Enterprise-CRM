{
  "name": "enterprise-crm-backend",
  "version": "1.0.0",
  "description": "Enterprise CRM Backend API - Node.js Express TypeScript",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test:auth": "tsx src/tests/auth.rbac.test.ts",
    "test:db": "tsx src/tests/database.integration.test.ts",
    "test:api": "tsx src/tests/core-api.integration.test.ts",
    "test:smoke": "tsx src/tests/live-api.smoke.test.ts",
    "test:phase2": "tsx src/tests/phase2-cutover.e2e.test.ts",
    "test:phase3": "tsx src/tests/phase3-cutover.e2e.test.ts",
    "migrate": "tsx src/database/migrator.ts",
    "seed": "tsx src/database/seed.ts",
    "seed:reference": "tsx src/database/seed-reference.ts",
    "seed:fixtures": "tsx src/database/seed-dev-fixtures.ts",
    "db:cleanup": "tsx src/database/cleanup-demo-data.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
